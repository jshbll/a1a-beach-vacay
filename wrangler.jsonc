{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "a1a-lodgify-proxy",
  "main": "src/lodgify-proxy.js",
  "compatibility_date": "2026-06-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "kv_namespaces": [
    {
      "binding": "A1A_LODGIFY_CACHE",
      "id": "82ebd2307ab548aea4c9cc325c9819bf"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REFRESH_COORDINATOR",
        "class_name": "RefreshCoordinator"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RefreshCoordinator"]
    }
  ],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "vars": {
    "LODGIFY_WEBSITE_ID": "410037",
    "PUBLIC_CACHE_TTL_SECONDS": "60",
    "STALE_WHILE_REVALIDATE_SECONDS": "300",
    "RATE_LIMIT_COOLDOWN_SECONDS": "900",
    "ROOM_FETCH_CONCURRENCY": "1",
    "ROOM_FETCH_DELAY_MS": "300",
    "PROPERTIES_PAGE_SIZE": "50",
    "MAX_PROPERTIES_PAGES": "20",
    "ALLOWED_ORIGINS": "https://www.a1abeachvacay.com,https://a1abeachvacay.com,http://localhost:8787,http://127.0.0.1:8787"
  }
}
